#!/usr/bin/env python3
"""Exercise real QML keyboard dispatch offscreen with an inert broker.

Uses Omarchy's installed UI controls. Only the layer-shell window is replaced
with a Qt Window; no desktop window or authenticated broker is started.
"""
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

root = Path(__file__).resolve().parents[1]
fixtures = root / "tests/keyboard"
with tempfile.TemporaryDirectory(prefix="rock-arch-keyboard-") as directory:
    stage = Path(directory)
    for source in (root / "plugin/oneall.rock-arch").iterdir():
        if source.suffix in (".qml", ".js"):
            shutil.copy2(source, stage / source.name)
    shutil.copytree("/usr/share/omarchy/shell/Ui", stage / "Ui")
    (stage / "Commons").symlink_to("/usr/share/omarchy/shell/Commons")
    shutil.copy2(fixtures / "KeyboardPanel.qml", stage / "Ui/KeyboardPanel.qml")
    shutil.copy2(fixtures / "RockArchBroker.qml", stage / "RockArchBroker.qml")
    shutil.copy2(fixtures / "shell.qml", stage / "shell.qml")
    qml = stage / "RockArch.qml"
    text = qml.read_text()
    qml.write_text(text.rstrip()[:-1] + (fixtures / "instrumentation.qmlpart").read_text() + "}\n")
    environment = dict(os.environ, QT_QPA_PLATFORM="offscreen", QT_QUICK_BACKEND="software")
    result = subprocess.run(["quickshell", "-p", str(stage), "--no-color"],
                            env=environment, capture_output=True, text=True, timeout=25, check=False)
    output = result.stdout + result.stderr
    failed = (result.returncode != 0 or "KEYBOARD_INTEGRATION_PASS" not in output or
              "KEYBOARD_INTEGRATION_FAIL" in output or "ERROR:" in output or
              (" WARN qml:" in output or " WARN scene:" in output) or "TypeError:" in output or "ReferenceError:" in output)
    if failed:
        print(output)
        sys.exit(1)
    print("Keyboard integration passed: real QML controls and shortcuts; inert broker; offscreen window.")
